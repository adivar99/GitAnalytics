# Multi-platform build Dockerfile for GitAnalytics CLI
# Supports building for different OS/ARCH combinations

FROM golang:1.21-alpine AS builder

# Build arguments for target platform
ARG GOOS=linux
ARG GOARCH=amd64

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /build

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the binary for the target platform
# CGO_ENABLED=0 for static binary (no C dependencies)
# -ldflags="-w -s" to reduce binary size (strip debug info)
RUN CGO_ENABLED=0 GOOS=${GOOS} GOARCH=${GOARCH} go build \
    -ldflags="-w -s" \
    -o gitanalytics-cli \
    .

# Verify the binary was created
RUN ls -lh gitanalytics-cli

